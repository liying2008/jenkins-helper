{
  "name": "jenkins-helper",
  "type": "module",
  "version": "3.0.0",
  "private": true,
  "description": "Monitor Jenkins build state and node state, and provide some convenient services.",
  "engines": {
    "node": ">=22",
    "yarn": ">=1.22.0"
  },
  "packageManager": "yarn@1.22.22",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "test": "vitest test",
    "browserslist": "browserslist --config=./.browserslistrc",
    "prepare": "husky",
    "taze": "npx taze"
  },
  "dependencies": {
    "localforage": "^1.10.0",
    "naive-ui": "^2.45.3",
    "pinia": "^4.1.0",
    "vue": "^3.5.46",
    "vue-router": "^5.5.1"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^10.0.0",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@crxjs/vite-plugin": "^3.0.0",
    "@iconify/json": "^2.2.561",
    "@types/chrome": "^0.3.7",
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^24.10.1",
    "@typescript-eslint/eslint-plugin": "^8.74.0",
    "@typescript-eslint/parser": "^8.74.0",
    "@unocss/preset-wind3": "^66.13.0",
    "@vicons/ionicons5": "^0.13.0",
    "@vitejs/plugin-vue": "^6.0.11",
    "@vue/test-utils": "^2.6.0",
    "@vue/tsconfig": "^0.9.1",
    "@vueuse/core": "^15.1.0",
    "cross-env": "^10.1.0",
    "eslint": "^10.15.0",
    "eslint-plugin-vue": "^10.12.1",
    "fs-extra": "^11.4.1",
    "husky": "^9.1.7",
    "jsdom": "^27.2.0",
    "postcss-html": "^2.0.1",
    "rfdc": "^1.4.1",
    "sass": "^1.108.2",
    "stylelint": "^18.1.0",
    "stylelint-config-html": "^2.0.0",
    "stylelint-config-recess-order": "^7.10.1",
    "stylelint-config-recommended-scss": "^18.0.0",
    "stylelint-config-recommended-vue": "^2.0.0",
    "stylelint-config-standard-scss": "^18.0.0",
    "stylelint-order": "^8.1.3",
    "typescript": "~5.9.3",
    "unocss": "^66.13.0",
    "unplugin-auto-import": "^21.1.0",
    "unplugin-vue-components": "^32.1.0",
    "vfonts": "^0.0.3",
    "vite": "^8.3.8",
    "vite-plugin-zip-pack": "^1.2.4",
    "vitest": "^5.1.1",
    "vue-tsc": "^3.3.14"
  }
}
