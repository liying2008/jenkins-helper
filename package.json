{
  "name": "jenkins-helper",
  "type": "module",
  "version": "3.0.0",
  "private": true,
  "description": "Monitor Jenkins build state and node state, and provide some convenient services.",
  "engines": {
    "node": ">=22",
    "pnpm": ">=10"
  },
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "test": "vitest test",
    "browserslist": "browserslist --config=./.browserslistrc",
    "prepare": "husky",
    "taze": "npx taze"
  },
  "dependencies": {
    "localforage": "^1.10.0",
    "naive-ui": "^2.43.2",
    "pinia": "^3.0.4",
    "vue": "^3.5.25",
    "vue-router": "^4.6.3"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^6.2.0",
    "@commitlint/cli": "^20.1.0",
    "@commitlint/config-conventional": "^20.0.0",
    "@crxjs/vite-plugin": "2.2.1",
    "@iconify/json": "^2.2.412",
    "@types/chrome": "^0.1.31",
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^24.10.1",
    "@typescript-eslint/eslint-plugin": "^8.48.0",
    "@typescript-eslint/parser": "^8.48.0",
    "@unocss/preset-wind3": "^66.5.9",
    "@vicons/ionicons5": "^0.13.0",
    "@vitejs/plugin-vue": "^6.0.2",
    "@vue/test-utils": "^2.4.6",
    "@vue/tsconfig": "^0.8.1",
    "@vueuse/core": "^14.1.0",
    "cross-env": "^10.1.0",
    "eslint": "^9.39.1",
    "eslint-plugin-vue": "^10.6.2",
    "fs-extra": "^11.3.2",
    "husky": "^9.1.7",
    "jsdom": "^27.2.0",
    "rfdc": "^1.4.1",
    "sass": "^1.94.2",
    "stylelint": "^16.26.1",
    "stylelint-config-recess-order": "^7.4.0",
    "stylelint-config-recommended-scss": "^16.0.2",
    "stylelint-config-recommended-vue": "^1.6.1",
    "stylelint-config-standard-scss": "^16.0.0",
    "typescript": "~5.8.3",
    "unocss": "^66.5.9",
    "unplugin-auto-import": "^20.3.0",
    "unplugin-vue-components": "^30.0.0",
    "vfonts": "^0.0.3",
    "vite": "^7.2.4",
    "vite-plugin-zip-pack": "^1.2.4",
    "vitest": "^4.0.14",
    "vue-tsc": "^3.1.5"
  }
}
