{
  "name": "jenkins-helper",
  "type": "module",
  "version": "3.0.0",
  "private": true,
  "description": "Monitor Jenkins build state and node state, and provide some convenient services.",
  "engines": {
    "node": ">=22",
    "pnpm": ">=10"
  },
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "test": "vitest test",
    "browserslist": "browserslist --config=./.browserslistrc",
    "prepare": "husky",
    "taze": "npx taze"
  },
  "dependencies": {
    "localforage": "^1.10.0",
    "naive-ui": "^2.45.3",
    "pinia": "^4.0.3",
    "vue": "^3.5.43",
    "vue-router": "^5.3.1"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.5.1",
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@crxjs/vite-plugin": "^2.7.0",
    "@iconify/json": "^2.2.412",
    "@types/chrome": "^0.3.4",
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^24.10.1",
    "@typescript-eslint/eslint-plugin": "^8.71.1",
    "@typescript-eslint/parser": "^8.71.1",
    "@unocss/preset-wind3": "^66.10.5",
    "@vicons/ionicons5": "^0.13.0",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vue/test-utils": "^2.5.1",
    "@vue/tsconfig": "^0.9.1",
    "@vueuse/core": "^15.0.0",
    "cross-env": "^10.1.0",
    "eslint": "^10.12.0",
    "eslint-plugin-vue": "^10.11.1",
    "fs-extra": "^11.3.2",
    "husky": "^9.1.7",
    "jsdom": "^27.2.0",
    "rfdc": "^1.4.1",
    "sass": "^1.105.1",
    "stylelint": "^17.16.0",
    "stylelint-config-recess-order": "^7.8.0",
    "stylelint-config-recommended-scss": "^17.0.1",
    "stylelint-config-recommended-vue": "^2.0.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "typescript": "~5.9.3",
    "unocss": "^66.10.5",
    "unplugin-auto-import": "^21.1.0",
    "unplugin-vue-components": "^32.1.0",
    "vfonts": "^0.0.3",
    "vite": "^8.3.3",
    "vite-plugin-zip-pack": "^1.2.4",
    "vitest": "^4.0.14",
    "vue-tsc": "^3.3.12"
  }
}
